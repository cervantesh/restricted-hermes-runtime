FROM python:3.11-slim AS builder
WORKDIR /build
COPY pyproject.toml ./
COPY src ./src
RUN pip install --no-cache-dir . \
 && find /usr/local/lib/python3.11/site-packages/restricted_runtime -type d -name __pycache__ -prune -exec rm -rf {} + \
 && rm -f /usr/local/lib/python3.11/site-packages/restricted_runtime/vertex.py \
           /usr/local/lib/python3.11/site-packages/restricted_runtime/google_kms.py \
           /usr/local/lib/python3.11/site-packages/restricted_runtime/gateway_client.py \
           /usr/local/lib/python3.11/site-packages/restricted_runtime/reconciliation.py \
           /usr/local/lib/python3.11/site-packages/restricted_runtime/reconciliation_driver.py \
           /usr/local/lib/python3.11/site-packages/restricted_runtime/services/production_gateway.py \
           /usr/local/lib/python3.11/site-packages/restricted_runtime/services/production_conversation.py \
           /usr/local/lib/python3.11/site-packages/restricted_runtime/services/restricted_api.py

FROM python:3.11-slim AS runtime
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 RESTRICTED_UDS_APP=restricted_runtime.services.production_local_gateway:app RESTRICTED_UDS_PATH=/run/restricted-inference/gateway.sock
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin/uvicorn /usr/local/bin/uvicorn
COPY policy/generated/policy.json policy/generated/policy.sig ./policy/generated/
RUN useradd --system --uid 10005 restricted-local-gateway \
 && mkdir -p /run/restricted-inference \
 && chown 10005:10005 /run/restricted-inference
USER 10005
CMD ["python", "-m", "restricted_runtime.uds_entrypoint"]
