FROM python:3.11-slim AS runtime
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY pyproject.toml ./
COPY src ./src
COPY policy ./policy
RUN pip install --no-cache-dir . \
 && rm -rf /app/src /app/build /app/pyproject.toml \
 && find /usr/local/lib/python3.11/site-packages/restricted_runtime -type d -name __pycache__ -prune -exec rm -rf {} + \
 && rm -f /usr/local/lib/python3.11/site-packages/restricted_runtime/vertex.py \
           /usr/local/lib/python3.11/site-packages/restricted_runtime/services/production_gateway.py \
           /usr/local/lib/python3.11/site-packages/restricted_runtime/services/gateway_api.py \
 && useradd --system --uid 10001 restricted
USER 10001
EXPOSE 8080
CMD ["uvicorn", "restricted_runtime.services.production_conversation:app", "--host", "0.0.0.0", "--port", "8080"]
