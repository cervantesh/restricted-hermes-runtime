FROM python@sha256:d1053354624536b044162aaab1e418bd000ea35184fb1ae098ab3166b1072e72 AS builder
WORKDIR /build
COPY pyproject.toml ./
COPY src ./src
COPY requirements/immutable/clinical-adapter.txt /requirements/clinical-adapter.txt
RUN python -m pip install --no-cache-dir --require-hashes --no-deps --only-binary=:all: -r /requirements/clinical-adapter.txt \
 && pip install --no-cache-dir --no-deps . --no-build-isolation \
 && find /usr/local/lib/python3.11/site-packages/restricted_runtime -type f -name '*.py' \
      ! -name '__init__.py' ! -name 'contracts.py' ! -name 'clinical_adapter.py' \
      ! -name 'upstream_deadline.py' \
      ! -name 'production_clinical_adapter.py' -delete \
 && find /usr/local/lib/python3.11/site-packages/restricted_runtime -type d -name __pycache__ -prune -exec rm -rf {} +

FROM python@sha256:d1053354624536b044162aaab1e418bd000ea35184fb1ae098ab3166b1072e72
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
RUN groupadd --system --gid 20006 restricted-clinical-query \
 && groupadd --system --gid 20007 restricted-clinical-adapter \
 && useradd --system --uid 10008 --gid 20007 --groups 20006 restricted-clinical-adapter
USER restricted-clinical-adapter
CMD ["python", "-m", "restricted_runtime.services.production_clinical_adapter"]
