FROM python:3.11-slim
WORKDIR /app
COPY deploy/local/ollama/adapter.py /app/adapter.py
RUN groupadd --system --gid 20000 restricted-socket-dir \
 && groupadd --system --gid 20003 restricted-broker \
 && useradd --system --uid 10003 --gid 20003 --groups 20000 restricted-ollama-adapter
USER 10003:20003
CMD ["python", "/app/adapter.py"]
