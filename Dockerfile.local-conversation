FROM python:3.11-slim AS builder
WORKDIR /build
COPY pyproject.toml ./
COPY src ./src
RUN pip install --no-cache-dir . && find /usr/local/lib/python3.11/site-packages/restricted_runtime -type d -name __pycache__ -prune -exec rm -rf {} + && rm -f /usr/local/lib/python3.11/site-packages/restricted_runtime/vertex.py /usr/local/lib/python3.11/site-packages/restricted_runtime/google_kms.py /usr/local/lib/python3.11/site-packages/restricted_runtime/gateway_client.py /usr/local/lib/python3.11/site-packages/restricted_runtime/services/production_gateway.py /usr/local/lib/python3.11/site-packages/restricted_runtime/services/production_conversation.py
FROM python:3.11-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin/uvicorn /usr/local/bin/uvicorn
COPY policy/generated/policy.json policy/generated/policy.sig ./policy/generated/
RUN useradd --system --uid 10006 restricted-local-conversation
USER 10006
CMD ["uvicorn", "restricted_runtime.services.production_local_conversation:app", "--uds", "/run/restricted-inference/conversation.sock"]
