FROM python:3.11-slim AS builder
WORKDIR /build
COPY pyproject.toml ./
COPY src ./src
RUN pip install --no-cache-dir . && find /usr/local/lib/python3.11/site-packages/restricted_runtime -type d -name __pycache__ -prune -exec rm -rf {} + && rm -f /usr/local/lib/python3.11/site-packages/restricted_runtime/vertex.py /usr/local/lib/python3.11/site-packages/restricted_runtime/google_kms.py /usr/local/lib/python3.11/site-packages/restricted_runtime/gateway_client.py /usr/local/lib/python3.11/site-packages/restricted_runtime/gateway.py /usr/local/lib/python3.11/site-packages/restricted_runtime/local_uds.py /usr/local/lib/python3.11/site-packages/restricted_runtime/storage.py /usr/local/lib/python3.11/site-packages/restricted_runtime/services/production_gateway.py /usr/local/lib/python3.11/site-packages/restricted_runtime/services/production_conversation.py
FROM python:3.11-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 RESTRICTED_UDS_APP=restricted_runtime.services.production_local_conversation:app RESTRICTED_UDS_PATH=/run/restricted-inference/conversation.sock
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin/uvicorn /usr/local/bin/uvicorn
COPY policy/generated/policy.json policy/generated/policy.sig ./policy/generated/
RUN useradd --system --uid 10006 restricted-local-conversation \
 && mkdir -p /run/restricted-inference \
 && chown 10006:10006 /run/restricted-inference
USER 10006
CMD ["python", "-m", "restricted_runtime.uds_entrypoint"]
